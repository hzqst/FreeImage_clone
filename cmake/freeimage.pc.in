prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: FreeImage
Description: FreeImage is an Open Source library project for developers who would like to support popular graphics image formats like PNG, BMP, JPEG, TIFF and others
Version: @PROJECT_VERSION@
Libs: -L${libdir} -lfreeimage
Cflags: -I${includedir} 